# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadzaro
DB_USER=leadzaro_user
DB_PASS=leadzaro_pass

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200

# ─── Google Places API ────────────────────────────────────────────────────────
# Get your key at https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ─── Stripe (Phase 3 billing — no real test-mode credentials configured yet) ──
# 'mock' simulates Payment Links/webhooks for building and testing the full
# internal workflow; 'disabled' (the production default) rejects billing
# actions instead of silently pretending a payment succeeded; 'live' uses the
# real Stripe SDK and requires real STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET.
STRIPE_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ─── CRM enrichment (no real provider integrated yet) ─────────────────────────
# 'mock' returns clearly-labeled fake demo data; 'disabled' (the production
# default) returns a "not configured" result instead of fabricating data.
ENRICHMENT_PROVIDER=mock

# ─── Google Calendar (Phase 4 meetings — no real credentials configured yet) ──
# 'mock' simulates event creation; 'disabled' (the production default) lets
# meetings still be requested/confirmed inside Leadzaro without a real
# calendar event; 'live' requires a real service-account credentials JSON.
GOOGLE_CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=

# ─── Google Cloud Storage (Phase 4 files — no real credentials configured yet) ─
# 'mock' simulates upload/signed-URL/delete in memory; 'disabled' (the
# production default) rejects file operations instead of silently
# succeeding; 'live' requires a real GCS service-account credentials JSON.
STORAGE_PROVIDER=mock
GCS_CREDENTIALS_JSON=
GCS_BUCKET_NAME=
