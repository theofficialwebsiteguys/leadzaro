# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# On Heroku, the Postgres add-on sets DATABASE_URL (TLS is used automatically)
# and the DB_* values below are not needed.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadzaro
DB_USER=leadzaro_user
DB_PASS=leadzaro_pass

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200

# ─── Access control ───────────────────────────────────────────────────────────
# Leadzaro is an internal Website Guys tool: accounts are created by an admin
# via the invitation flow (Administration → Invitations), never by public
# self-signup. Keep this false in every environment; it must only be flipped
# on for local/dev testing of the registration form itself.
FEATURE_PUBLIC_REGISTRATION=false

# ─── Google Places API ────────────────────────────────────────────────────────
# Get your key at https://developers.google.com/maps/documentation/places/web-service
# The key must have "Places API (New)" and "Geocoding API" enabled. Enable
# "Maps Static API" too for the results map on Find Leads (optional — the map
# falls back to a plain grid without it). The key is only ever used server-side.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ─── Stripe (sales payments, ADR 0011) ────────────────────────────────────────
# 'mock' simulates Stripe for development; 'disabled' (the production default)
# rejects payment actions; 'live' talks to your real Stripe account.
# Use a RESTRICTED key (rk_test_... first, rk_live_... when ready). Test and
# live records are kept apart automatically from the key's mode.
# Restricted key permissions — Write: Customers, Checkout Sessions, Payment
# Links, Prices, Products, Customer portal. Read: Invoices, Subscriptions.
# Optional Read: Account (to show the connected account name).
# Webhook endpoint: https://<your-api-host>/api/v1/billing/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, invoice.paid,
# invoice.payment_failed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, charge.refunded
STRIPE_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Only enable once Stripe Tax is configured in the account.
STRIPE_AUTOMATIC_TAX=false
STRIPE_ALLOW_PROMOTION_CODES=false
STRIPE_DEFAULT_CURRENCY=usd
# Customer-bound checkout links expire after this many hours (1-24).
STRIPE_CHECKOUT_EXPIRY_HOURS=24

# ─── Outreach email (ADR 0011) ────────────────────────────────────────────────
# 'console' logs emails (development); 'smtp' sends through the server below
# (e.g. Google Workspace smtp.gmail.com:587 with an app password).
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@example.com
SALES_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Safe test path (ADR 0014): when set, every outreach email goes to this
# address instead of the lead, with the intended recipient in the subject.
# Leave blank in production.
SALES_EMAIL_TEST_REDIRECT=

# ─── Texting and click-to-call (Twilio, ADR 0011) ───────────────────────────
# Leave blank to keep SMS/calls as "not connected" (logged by hand).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Public https URL of this API (for delivery updates and text replies).
PUBLIC_API_BASE_URL=
# Paying clients are not invited to log in unless this is true.
CLIENT_PORTAL_AUTO_INVITE=false

# ─── CRM enrichment (no real provider integrated yet) ─────────────────────────
# 'mock' returns clearly-labeled fake demo data; 'disabled' (the production
# default) returns a "not configured" result instead of fabricating data.
ENRICHMENT_PROVIDER=mock

# ─── Google Calendar (Phase 4 meetings — no real credentials configured yet) ──
# 'mock' simulates event creation; 'disabled' (the production default) lets
# meetings still be requested/confirmed inside Leadzaro without a real
# calendar event; 'live' requires a real service-account credentials JSON.
GOOGLE_CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=

# ─── File storage (client media/files) ─────────────────────────────────────
# 'local' (the development default) stores real files under
# LOCAL_STORAGE_DIR and serves them through short-lived signed links, so
# uploads can be previewed and downloaded; 'mock' (the test default) keeps
# them in memory only; 'disabled' (the production default) rejects file
# operations; 'live' uses Google Cloud Storage and requires a real
# service-account credentials JSON.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=server/.dev-storage
GCS_CREDENTIALS_JSON=
GCS_BUCKET_NAME=

# ─── GitHub (Phase 6 website repositories — no real GitHub App configured yet) ─
# 'mock' simulates a full repo/branch/commit/PR/Pages-preview lifecycle in
# memory; 'disabled' (the production default) rejects repository/deployment
# actions instead of silently pretending they succeeded; 'live' requires a
# real GitHub App credentials JSON and the target GitHub organization.
GITHUB_PROVIDER=mock
GITHUB_APP_CREDENTIALS_JSON=
GITHUB_ORG=

# ─── Namecheap (Phase 7 domain records — no real API credentials configured yet) ─
# 'mock' simulates a full domain registry (register/renew/transfer/DNS) in
# memory; 'disabled' (the production default) rejects domain actions instead
# of silently pretending they succeeded; 'live' requires a real Namecheap
# API credentials JSON. No real domain is ever registered and no real DNS is
# ever changed from this codebase without explicit operator-provided
# credentials outside this environment.
NAMECHEAP_PROVIDER=mock
NAMECHEAP_API_CREDENTIALS_JSON=

# ─── cPanel (Phase 7 shared hosting — no real API credentials configured yet) ──
# 'mock' simulates a full upload/backup/restore/health-check hosting-account
# lifecycle in memory; 'disabled' (the production default) rejects deploy
# actions instead of silently pretending they succeeded; 'live' requires a
# real cPanel API credentials JSON. No real upload ever occurs from this
# codebase without explicit operator-provided credentials outside this
# environment.
CPANEL_PROVIDER=mock
CPANEL_API_CREDENTIALS_JSON=

# ─── SEO audit (Phase 8 broken-link/performance checks — no real provider configured yet) ─
# 'mock' simulates link/performance check results (configurable per-URL for
# testing); 'disabled' (the production default) rejects audit actions
# instead of silently pretending they succeeded; 'live' requires a real
# audit provider credentials JSON. Heading/alt-text checks never need this
# — they run structurally against the website's own schema.
SEO_AUDIT_PROVIDER=mock
SEO_AUDIT_API_CREDENTIALS_JSON=
